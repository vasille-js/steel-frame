{
  "name": "babel-plugin-vasille",
  "version": "5.1.3",
  "description": "Convert Vasille Meta Language code to pure JavaScript",
  "main": "lib/index.js",
  "type": "commonjs",
  "exports": {
    "import": "./lib/index.js",
    "browser": "./lib/index.js",
    "node": "./lib/index.js",
    "require": "./lib/index.js",
    "types": "./types/index.d.ts"
  },
  "scripts": {
    "prepack": "cp -f ../README.md ./README.md",
    "prettier": "prettier src test/**/*.ts* test/*.ts --write",
    "prebuild": "rm -rf lib types",
    "build": "tsc --build tsconfig-build.json",
    "tsc-tests": "tsc --build test/tsconfig.json",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "keywords": [
    "front-end",
    "framework",
    "web",
    "compiler",
    "babel"
  ],
  "author": "lixcode",
  "license": "LGPL-2.1-only",
  "bugs": {
    "url": "https://github.com/vasille-js/vasille-js/issues"
  },
  "homepage": "https://github.com/vasille-js/vasille-js#readme",
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "jest": "^30.5.2",
    "jsdom": "^30.1.1",
    "path": "^0.12.7",
    "prettier": "^3.9.9",
    "steel-frame": "file:../steel-frame",
    "ts-jest": "^29.4.13",
    "typescript": "^6.0.3",
    "vasille": "file:../core"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "@parcel/watcher@2.6.0": true
  }
}
