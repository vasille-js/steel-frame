{
    "include": ["./**/*.ts", "./**/*.tsx"],

    "compilerOptions": {
        "rootDir": "../",
        "allowJs": true,
        "declaration": false,
        "noEmit": true,
        "target": "ES2024",
        "module": "Node16",
        "moduleResolution": "node16",
        "jsx": "preserve",
        "jsxImportSource": "steel-frame",
        "skipLibCheck": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "lib": ["ES2024", "DOM"],
        "paths": {
            "steel-frame": ["../src/export/index.ts"],
            "steel-frame/jsx-runtime": ["../src/export/jsx-runtime.ts"]
        },
        "types": ["jest", "node"]
    }
}
