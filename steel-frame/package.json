{
    "name": "steel-frame",
    "version": "7.2.2",
    "description": "Carefree Web Applications Development.",
    "main": "build/cli/run.js",
    "types": "./index.d.ts",
    "bin": {
        "web": "build/cli/run.js"
    },
    "exports": {
        ".": {
            "types": "./build/export/index.d.ts",
            "import": "./build/export/index.js",
            "browser": "./build/export/index.js",
            "node": "./build/export/index.js"
        },
        "./babel-plugin": {
            "types": "./build/babel-plugin/index.d.ts",
            "import": "./build/babel-plugin/index.js",
            "browser": "./build/babel-plugin/index.js",
            "node": "./build/babel-plugin/index.js"
        },
        "./core": {
            "types": "./build/vasille/index.d.ts",
            "import": "./build/vasille/index.js",
            "browser": "./build/vasille/index.js",
            "node": "./build/vasille/index.js"
        },
        "./core-dev": {
            "types": "./build/vasille/dev/index.d.ts",
            "import": "./build/vasille/dev/index.js",
            "browser": "./build/vasille/dev/index.js",
            "node": "./build/vasille/dev/index.js"
        },
        "./web": {
            "types": "./build/vasille-web/web/index.d.ts",
            "import": "./build/vasille-web/web/index.js",
            "browser": "./build/vasille-web/web/index.js",
            "node": "./build/vasille-web/web/index.js"
        },
        "./web-dev": {
            "types": "./build/vasille-web/dev/index.d.ts",
            "import": "./build/vasille-web/dev/index.js",
            "browser": "./build/vasille-web/dev/index.js",
            "node": "./build/vasille-web/dev/index.js"
        },
        "./shadow": {
            "types": "./build/vasille-web/shadow/index.d.ts",
            "import": "./build/vasille-web/shadow/index.js",
            "browser": "./build/vasille-web/shadow/index.js",
            "node": "./build/vasille-web/shadow/index.js"
        },
        "./shadow-types": {
            "types": "./build/vasille-web/shadow/types.d.ts",
            "import": "./build/vasille-web/shadow/types.js",
            "browser": "./build/vasille-web/shadow/types.js",
            "node": "./build/vasille-web/shadow/types.js"
        },
        "./ssg": {
            "types": "./build/vasille-web/ssg/index.d.ts",
            "import": "./build/vasille-web/ssg/index.js",
            "browser": "./build/vasille-web/ssg/index.js",
            "node": "./build/vasille-web/ssg/index.js"
        },
        "./types": {
            "types": "./build/vasille-web/types/index.d.ts",
            "import": "./build/vasille-web/types/index.js",
            "browser": "./build/vasille-web/types/index.js",
            "node": "./build/vasille-web/types/index.js"
        },
        "./jsx-runtime": {
            "types": "./build/export/jsx-runtime.d.ts",
            "import": "./build/export/jsx-runtime.js",
            "browser": "./build/export/jsx-runtime.js",
            "node": "./build/export/jsx-runtime.js"
        }
    },
    "scripts": {
        "prepack": "cp -f ../README.md ./README.md",
        "prettier": "prettier src test --write",
        "prebuild": "rm -rf build",
        "build": "tsc --build tsconfig.json",
        "tsc-tests": "tsc --build test/tsconfig.json",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test-coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vasille-js/steel-frame.git"
    },
    "keywords": [
        "frontend",
        "framework",
        "fast",
        "simple",
        "safe"
    ],
    "author": "lixcode",
    "license": "LGPL-2.1-only",
    "bugs": {
        "url": "https://github.com/vasille-js/steel-frame/issues"
    },
    "homepage": "https://github.com/vasille-js/steel-frame#readme",
    "dependencies": {
        "@babel/plugin-syntax-jsx": "^7.29.7",
        "@babel/plugin-transform-typescript": "^7.29.9",
        "@inquirer/select": "^5.2.6",
        "@types/escape-html": "^1.0.4",
        "csstype": "^3.1.3",
        "esbuild": "^0.28.2",
        "escape-html": "^1.0.3",
        "vite": "^8.3.4",
        "vite-plugin-babel": "^1.7.3",
        "vite-plugin-inspect": "^12.1.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.3.0",
        "@types/web": "^0.0.256",
        "@types/ws": "^8.18.2",
        "babel-jest": "^30.5.2",
        "jest": "^30.5.2",
        "jsdom": "^29.1.1",
        "prettier": "^3.6.2",
        "steel-frame": "file:.",
        "typescript": "^7.0.2",
        "typescript5": "npm:typescript@^5"
    }
}
