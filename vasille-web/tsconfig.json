{
    "include": ["src/**/*"],

    "compilerOptions": {
        "allowJs": true,
        "declaration": true,
        "rootDir": ".",
        "outDir": "build",
        "declarationDir": "build",
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "node16",
        "lib": ["es2024", "dom"],
        "skipLibCheck": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "types": ["node"]
    }
}
