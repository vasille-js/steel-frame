{
    "name": "vasille-web",
    "version": "7.0.0-rc.3",
    "description": "Build fault tolerant web applications.",
    "main": "index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./build/web/index.d.ts",
            "import": "./build/web/index.js",
            "browser": "./build/web/index.js",
            "node": "./build/web/index.js"
        },
        "./jsx-runtime": {
            "types": "./build/web/jsx/jsx-runtime.d.ts",
            "import": "./build/web/jsx/jsx-runtime.js",
            "browser": "./build/web/jsx/jsx-runtime.js",
            "node": "./build/web/jsx/jsx-runtime.js"
        },
        "./dev": {
            "types": "./build/dev/index.d.ts",
            "import": "./build/dev/index.js",
            "browser": "./build/dev/index.js",
            "node": "./build/dev/index.js"
        },
        "./shadow": {
            "types": "./build/shadow/index.d.ts",
            "import": "./build/shadow/index.js",
            "browser": "./build/shadow/index.js",
            "node": "./build/shadow/index.js"
        },
        "./shadow-types": {
            "types": "./build/shadow/types.d.ts",
            "import": "./build/shadow/types.js",
            "browser": "./build/shadow/types.js",
            "node": "./build/shadow/types.js"
        },
        "./ssg": {
            "types": "./build/ssg/index.d.ts",
            "import": "./build/ssg/index.js",
            "browser": "./build/ssg/index.js",
            "node": "./build/ssg/index.js"
        },
        "./types": {
            "types": "./build/types/index.d.ts",
            "import": "./build/types/index.js",
            "browser": "./build/types/index.js",
            "node": "./build/types/index.js"
        }
    },
    "scripts": {
        "prepack": "cp -f ../README.md ./README.md",
        "prettier": "prettier src --write",
        "tsc-tests": "tsc --build test/tsconfig.json",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test-coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "prebuild": "rm -rf build",
        "build": "tsc --build tsconfig.json"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vasille-js/vasille-js.git"
    },
    "keywords": [
        "frontend",
        "dx",
        "fast",
        "simple",
        "secure"
    ],
    "author": "lixcode",
    "license": "LGPL-2.1-only",
    "bugs": {
        "url": "https://github.com/vasille-js/vasille-js/issues"
    },
    "homepage": "https://github.com/vasille-js/vasille-js#readme",
    "dependencies": {
        "csstype": "^3.1.3",
        "escape-html": "^1.0.3",
        "vasille": "file:../vasille"
    },
    "devDependencies": {
        "@babel/plugin-transform-typescript": "^7.29.9",
        "@types/jest": "^30.0.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.3.0",
        "@types/web": "^0.0.256",
        "jest": "^30.5.2",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.10",
        "steel-frame": "file:../steel-frame",
        "ts-jest": "^29.4.14",
        "typescript": "^5.8.3"
    }
}
