{
  "include": ["src/**/*"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "build",
    "declarationDir": "build",
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strictNullChecks": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "debug",
      "node",
      "estree",
      "events",
      "jest",
      "json-schema"
    ]
  },
}
